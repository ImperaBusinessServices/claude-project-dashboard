{
  "name": "claude-manager",
  "version": "2.17.0",
  "description": "Terminal Project Dashboard - manage your AI terminal project folders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "author": "Keith",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.keith.claude-manager",
    "productName": "Terminal Project Dashboard",
    "afterPack": "./afterPack.js",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "shortcutName": "Terminal Project Dashboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "tray-flyout.html",
      "icon.ico",
      "icon.png",
      "tray-icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  }
}
